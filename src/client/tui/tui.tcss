Screen {
    background: #000000;
    color: #ffffff;
    scrollbar-visibility: hidden;
}

#main-scroll {
    height: 1fr;
    scrollbar-visibility: visible;
}
#info-box {
    border: heavy #ffffff;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    layout: horizontal;
    border-title-color: #ffffff;
    border-title-style: bold;
    border-title-align: center;
}
#left-pane {
    width: 35%;
    height: auto;
    padding: 1;
}
#right-pane {
    width: 65%;
    height: auto;
    padding: 1;
}
#logo {
    color: #ffffff;
    margin-bottom: 1;
}
.meta-title {
    color: #a3a3a3;
    text-style: bold;
}
.section-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
}
.tool-item {
    color: #a3a3a3;
    margin-bottom: 1;
}


#feedback-banner {
    display: none;
    width: 1fr;
    padding: 0 1;
    color: #fbbf24;
    border: round #fbbf24;
    height: auto;
}

#message-history {
    height: auto;
    padding: 1;
}

.message-box {
    border-left: solid #ffffff;
    margin-bottom: 1;
    padding: 0 1;
    height: auto;
}

.user-message-sender {
    color: #94a3b8;
    text-style: bold;
}
.user-message-content {
    color: #a3a3a3;
    margin-left: 2;
}

.agent-message-sender {
    color: #ffffff;
    text-style: bold;
}
.agent-message-content {
    color: #d3d3d3;
    margin-left: 2;
}

.thinking-container {
    height: auto;
    margin-bottom: 0;
    layout: vertical;
}

.thinking-header {
    border-top: solid #5a5a5a;
    border-left: solid #5a5a5a;
    border-right: none;
    border-bottom: none;
    border-title-align: left;
    border-title-style: italic;
    height: 1;
    width: 20;
    margin: 0;
    padding: 0;
}

.thinking-content {
    color: #5a5a5a;
    text-style: italic;
    margin-left: 2;
    height: auto;
}


#status-bar {
    height: 1;
    background: #171717;
    margin-bottom: 1;
    layout: horizontal;
}
#status-badge {
    color: #000000;
    background: #ffffff;
    text-style: bold;
    padding: 0 1;
    width: auto;
}
#status-metrics {
    color: #d4d4d4;
    padding-left: 1;
    text-style: bold;
}


#input-row {
    height: 1;
    layout: horizontal;
}
#prompt-char {
    color: #ffffff;
    width: auto;
    padding-left: 1;
}
Input {
    border: none;
    background: transparent;
    color: #ffffff;
    width: 1fr;
    height: 1;
    padding: 0;
    margin: 0;
}
Input:focus {
    border: none;
}

/* Session List */
#session-list {
    display: none;
    width: 100%;
    height: 1fr;
    border: heavy #ffffff;
    margin: 1 0;
    padding: 1;
    background: #0a0a0a;
}

.session-list-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
}

.session-list-hint {
    color: #666666;
    text-style: italic;
    margin-top: 1;
    text-align: center;
}

#session-list-view {
    height: 1fr;
    border: solid #333333;
    background: #000000;
}

#session-list-view > ListItem {
    height: 3;
    padding: 0 1;
}

#session-list-view > ListItem:hover {
    background: #1a1a1a;
}

#session-list-view > ListItem.-highlighted {
    background: #333333;
    border: solid #ffffff;
}

.session-item-title {
    color: #a3a3a3;
    height: 1;
    width: 1fr;
}